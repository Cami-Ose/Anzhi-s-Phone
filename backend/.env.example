# 安知手机 后端 · 环境变量
# 复制此文件为 .env（已附带 .env 文件）

# ── 服务 ──
PORT=8080
HOST=0.0.0.0
WS_MAX_MSG_SIZE=10485760

# ── VPS 基础设施 ──
# 手机直调 DeepSeek/Gemini API，VPS 只需要连接各站点
MEMORY_API_URL=https://memory.example.com
BODY_API_URL=https://body.example.com
CHAT_API_URL=https://chat.example.com

# ── 日志 ──
LOG_LEVEL=INFO
