#
# 保护 persist.anzhi.* 系统属性不被非授权进程读写。
# 安装路径：system/sepolicy/private/property_contexts
#
# 使用方法：
#   编译时复制到 system/sepolicy/private/property_contexts
#   或通过 build_rom.sh deploy_source() 自动注入
# =============================================================================

# 安知系统属性（服务器地址、API Key 等敏感配置）
persist.anzhi.            u:object_r:anzhi_prop:s0
persist.anzhi.server_url  u:object_r:anzhi_prop:s0
persist.anzhi.deepseek_key u:object_r:anzhi_prop:s0
persist.anzhi.gemini_key   u:object_r:anzhi_prop:s0
