<?xml version="1.0" encoding="utf-8"?>
<!--
  BUILD.md Step 10 — 通知管理（Notification Assistant）

  ⚠️ 此文件必须在 ROM 编译时打入 /system/etc/default-permissions/。

  原因：即使 AndroidManifest 声明了 BIND_NOTIFICATION_ASSISTANT_SERVICE，
  Android 系统仍静默拒绝——必须用户去「设置 → 特殊应用权限 → 通知助理」手动点选。
  打入此文件后，系统开机自动将 com.anzhi.os 注册为已启用的 Notification Assistant，
  无需 Cami 手动操作。

  Step 14（SELinux 收紧 + AOSP 构建）编译时：
    将此文件复制到 TARGET_OUT_ETC/default-permissions/anzhi_assistant_grant.xml

  路径参考：
    - AOSP 源码：frameworks/base/core/res/res/values/config.xml
      （config_defaultEnabledNotificationAssistants 数组）
    - ROM 编译时两种注入方式：
      1. default-permissions XML → /system/etc/default-permissions/（推荐，LineageOS 支持）
      2. 在 device tree overlay 中覆盖 config.xml 的 config_defaultEnabledNotificationAssistants

  同时需要在 device.mk 中添加：
    PRODUCT_COPY_FILES += \
        vendor/anzhi/default-permissions/anzhi_assistant_grant.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/anzhi_assistant_grant.xml
-->
<default-permissions>
    <!-- 安知手机 Notification Assistant — 开机自启，无需手动授权 -->
    <enabled-notification-assistant package="com.anzhi.os" />

    <!-- 同时确保无障碍服务可被系统识别（Step 8 的 AccessibilityService） -->
    <enabled-accessibility-service package="com.anzhi.os" />
</default-permissions>
